# Upload packages copied to the root are release assets, not Git source
/kopiq-*.zip
/kopiq-*.tar.gz
/SHA256SUMS*.txt
/UPLOADS.md

# Preserve the existing choice to keep planning/mockups local.
# The canonical icon is required by desktop/build/Taskfile.yml.
/checklist.md
/docs/
/design/
/design/*
!/design/icon.png
